        iowrite32(&devs[devices[i]], SRC_OFFSET_REG, 0x0);
        iowrite32(&devs[devices[i]], DST_OFFSET_REG, 0x0);

        // Accelerator-specific registers
        iowrite32(&devs[devices[i]], TOKENS_REG, TOKENS);
        iowrite32(&devs[devices[i]], BATCH_REG, BATCH);
    }

    // Flush for non-coherent DMA
    esp_flush(coherence);

    // Start accelerator
    start = get_counter();

    for (int i = 0; i < num_multicast + 1; i++) {
        iowrite32(&devs[devices[i]], CMD_REG, CMD_MASK_START);
    }

