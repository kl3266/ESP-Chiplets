	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig BASIC_DMA512_V -top top

$(subst .v,_%.v,$(BDW_WORKLIB)/sims/top_BASIC_DMA512_V.v): top_v.bdt $(BDW_LOGOPTIONS_FILE)  
