	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA256/,/BASIC_DMA256$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/ -I./ $(CCFLAGS_dummy_BASIC_DMA256) $(EXTRACT_LIB_DASHI_dummy_BASIC_DMA256) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/xcelium/debug/dummy_hoist.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/dummy.d :  ../src/dummy.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC_DMA256 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_dummy_BASIC_DMA256)  ../src/dummy.cpp \
	| sed 's|dummy\.o[ :]*|$(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/xcelium/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/xcelium/debug/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/dummy.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
