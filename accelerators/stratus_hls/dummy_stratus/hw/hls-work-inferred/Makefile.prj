PREFIXED_LIB_NAMES_dummy_IOCFG_DMA512 = 
EXTRACT_LIB_DASHI_dummy_IOCFG_DMA512 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy IOCFG_DMA512]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_IOCFG_DMA512 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/c_parts  -DioConfig_IOCFG_DMA512 -D_p_ioConfig_IOCFG_DMA512 -DioConfig=IOCFG_DMA512 -D_wrap_ioConfig=IOCFG_DMA512 -DDMA_WIDTH=512 -D_wrap_DMA_WIDTH=512   $(LIB_INCLUDES_dummy_IOCFG_DMA512)
CCFLAGS_COSIM_dummy_IOCFG_DMA512 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/c_parts  -DioConfig_IOCFG_DMA512 -D_p_ioConfig_IOCFG_DMA512 -DioConfig=IOCFG_DMA512 -D_wrap_ioConfig=IOCFG_DMA512 -DDMA_WIDTH=512 -D_wrap_DMA_WIDTH=512   $(LIB_INCLUDES_dummy_IOCFG_DMA512)
CCFLAGS_BEH_dummy_IOCFG_DMA512 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/c_parts  -DioConfig_IOCFG_DMA512 -D_p_ioConfig_IOCFG_DMA512 -DioConfig=IOCFG_DMA512 -D_wrap_ioConfig=IOCFG_DMA512 -DDMA_WIDTH=512 -D_wrap_DMA_WIDTH=512   $(LIB_INCLUDES_dummy_IOCFG_DMA512)
CCFLAGS_dummy_IOCFG_DMA512 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_IOCFG_DMA512 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_IOCFG_DMA512 += ${BDW_CCFLAGS_TAIL}

