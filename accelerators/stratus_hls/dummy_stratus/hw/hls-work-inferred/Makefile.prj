$(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/xcelium/dummy_hoist.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
