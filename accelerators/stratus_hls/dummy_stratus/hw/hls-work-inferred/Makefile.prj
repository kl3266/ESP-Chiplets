CCFLAGS_tb_IOCFG_DMA64 = -I./ -I$(BDW_WRAPDIR) $(LIB_INCLUDES_tb_IOCFG_DMA64)   -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  
CCFLAGS_tb_IOCFG_DMA64 += ${BDW_CCFLAGS_TAIL}

$(BDW_WORKLIB)/modules/tb/IOCFG_DMA64/xcelium/system_beh.o : ../tb/system.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/tb/IOCFG_DMA64 -I./ $(CCFLAGS_tb_IOCFG_DMA64) -o $(BDW_WORKLIB)/modules/tb/IOCFG_DMA64/xcelium/system_beh.o " ../tb/system.cpp

