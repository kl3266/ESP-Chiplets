$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/xcelium/debug/dummy_beh.o :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(BDW_WORKLIB)/wrappers/dummy_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
