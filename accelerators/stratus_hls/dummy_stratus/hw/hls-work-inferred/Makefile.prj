	| sed 's|dummy\.o[ :]*|$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/xcelium/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/xcelium/debug/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

