##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512"
##############################################################

dummy_IOCFG_DMA512_SRCDIR = $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512
dummy_IOCFG_DMA512_BEH_SRCDIR = $(BDW_WORKLIB)/libs/dummy_IOCFG_DMA512
dummy_IOCFG_DMA512_LIBNAME = dummy_IOCFG_DMA512
dummy_IOCFG_DMA512_WORKLIB = $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/xcelium
dummy_IOCFG_DMA512_C_PARTS_A = $(dummy_IOCFG_DMA512_WORKLIB)/objs/libdummy_IOCFG_DMA512.a

prep_c_dummy_IOCFG_DMA512 : $(dummy_IOCFG_DMA512_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_IOCFG_DMA512_WORKLIB) prep_c

prep_vlog_dummy_IOCFG_DMA512 : $(dummy_IOCFG_DMA512_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_IOCFG_DMA512_WORKLIB) prep_vlog

prep_dummy_IOCFG_DMA512 : $(dummy_IOCFG_DMA512_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_IOCFG_DMA512_WORKLIB) prep

$(dummy_IOCFG_DMA512_WORKLIB)/Makefile : $(dummy_IOCFG_DMA512_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(dummy_IOCFG_DMA512_WORKLIB) ]; then mkdir -p $(dummy_IOCFG_DMA512_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_IOCFG_DMA512_SRCDIR) -o $(dummy_IOCFG_DMA512_WORKLIB)/Makefile -module dummy -cynthconfig IOCFG_DMA512   

$(dummy_IOCFG_DMA512_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(dummy_IOCFG_DMA512_WORKLIB) ]; then mkdir -p $(dummy_IOCFG_DMA512_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_dummy_IOCFG_DMA512_% : $(subst IOCFG_DMA512,IOCFG_DMA512_%,$(dummy_IOCFG_DMA512_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)) prep_c

prep_vlog_dummy_IOCFG_DMA512_% : $(subst IOCFG_DMA512,IOCFG_DMA512_%,$(dummy_IOCFG_DMA512_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)) prep_vlog

prep_dummy_IOCFG_DMA512_% : $(subst IOCFG_DMA512,IOCFG_DMA512_%,$(dummy_IOCFG_DMA512_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)) prep

$(subst IOCFG_DMA512,IOCFG_DMA512_%,$(dummy_IOCFG_DMA512_WORKLIB))/Makefile : $(dummy_IOCFG_DMA512_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)) ]; then mkdir -p $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_IOCFG_DMA512_SRCDIR)_$(*F) -o $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB))/Makefile -module dummy -cynthconfig IOCFG_DMA512_$(*F)   

$(dummy_IOCFG_DMA512_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)) ]; then mkdir -p $(subst IOCFG_DMA512,IOCFG_DMA512_$(*F),$(dummy_IOCFG_DMA512_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(dummy_IOCFG_DMA512_WORKLIB)/dummy_IOCFG_DMA512.d :
	@if [ ! -d $(dummy_IOCFG_DMA512_WORKLIB) ]; then mkdir -p $(dummy_IOCFG_DMA512_WORKLIB); fi
	@touch $(dummy_IOCFG_DMA512_WORKLIB)/dummy_IOCFG_DMA512.d



#
# HLS config BASIC_DMA512
#

#
#	stratus_hls rule
#
LIB_DIRS_dummy_BASIC_DMA512 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_BASIC_DMA512 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_BASIC_DMA512))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_BASIC_DMA512 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_dummy_BASIC_DMA512 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_dummy_BASIC_DMA512 = 
EXTRACT_LIB_DASHI_dummy_BASIC_DMA512 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy BASIC_DMA512]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_BASIC_DMA512 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/c_parts -DBASIC_DMA512=1 -DBDW_RTL_dummy_BASIC_DMA512=1 -DioConfig_IOCFG_DMA512 -D_p_ioConfig_IOCFG_DMA512 -DioConfig=IOCFG_DMA512 -D_wrap_ioConfig=IOCFG_DMA512 -DDMA_WIDTH=512 -D_wrap_DMA_WIDTH=512  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA512)
CCFLAGS_COSIM_dummy_BASIC_DMA512 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/c_parts -DBASIC_DMA512=1 -DBDW_RTL_dummy_BASIC_DMA512=1 -DioConfig_IOCFG_DMA512 -D_p_ioConfig_IOCFG_DMA512 -DioConfig=IOCFG_DMA512 -D_wrap_ioConfig=IOCFG_DMA512 -DDMA_WIDTH=512 -D_wrap_DMA_WIDTH=512  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA512)
CCFLAGS_BEH_dummy_BASIC_DMA512 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/c_parts -DBASIC_DMA512=1 -DioConfig_IOCFG_DMA512 -D_p_ioConfig_IOCFG_DMA512 -DioConfig=IOCFG_DMA512 -D_wrap_ioConfig=IOCFG_DMA512 -DDMA_WIDTH=512 -D_wrap_DMA_WIDTH=512  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA512)
CCFLAGS_dummy_BASIC_DMA512 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_BASIC_DMA512 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_BASIC_DMA512 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_dummy_BASIC_DMA512 hls_dummy_BASIC_DMA512

hls_dummy_BASIC_DMA512 : hlsc_dummy_BASIC_DMA512

cynth_dummy_BASIC_DMA512 : hlsc_dummy_BASIC_DMA512

elab_dummy_BASIC_DMA512 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/stratus_hls.bdr

optim_dummy_BASIC_DMA512 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/stratus_hls.bdr

sched_dummy_BASIC_DMA512 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/stratus_hls.bdr

hlsc_dummy_BASIC_DMA512 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC_DMA512 BDW_MODULE=dummy BDW_HLS_CONFIG=BASIC_DMA512 
else
	@bdw_exec -jobproject project.tcl -job hls.dummy.BASIC_DMA512 $(MAKE) CWBExec_hls=1 hlsc_dummy_BASIC_DMA512
endif

clean_cynth_dummy_BASIC_DMA512: clean_hls_dummy_BASIC_DMA512

clean_dummy_BASIC_DMA512: clean_hls_dummy_BASIC_DMA512

clean_hls_dummy_BASIC_DMA512:
	@rm -rf $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.BASIC_DMA512
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.BASIC_DMA512.s

kill_hls_dummy_BASIC_DMA512:
	@bdw_kill -job hls.dummy.BASIC_DMA512
	@bdw_kill -job hls.dummy.BASIC_DMA512.s


hls_dummy_BASIC_DMA512_% : hlsc_dummy_BASIC_DMA512_%

cynth_dummy_BASIC_DMA512_% : hlsc_dummy_BASIC_DMA512_%

elab_dummy_BASIC_DMA512_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /BASIC_DMA512/,/BASIC_DMA512_$(*F)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/stratus_hls.bdr)

optim_dummy_BASIC_DMA512_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /BASIC_DMA512/,/BASIC_DMA512_$(*F)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/stratus_hls.bdr)

sched_dummy_BASIC_DMA512_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /BASIC_DMA512/,/BASIC_DMA512_$(*F)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/stratus_hls.bdr)

hlsc_dummy_BASIC_DMA512_% hls_dummy_BASIC_DMA512_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC_DMA512/,/BASIC_DMA512_$(*F)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC_DMA512 BDW_MODULE=dummy BDW_HLS_CONFIG=BASIC_DMA512_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.dummy.BASIC_DMA512_$(*F) $(MAKE) CWBExec_hls=1 hlsc_dummy_BASIC_DMA512_$(*F)
endif

clean_cynth_dummy_BASIC_DMA512_%: clean_hls_dummy_BASIC_DMA512_%

clean_dummy_BASIC_DMA512_%: clean_hls_dummy_BASIC_DMA512_%

clean_hls_dummy_BASIC_DMA512_%:
	@rm -rf $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.BASIC_DMA512_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.BASIC_DMA512_$(*F).s

kill_hls_dummy_BASIC_DMA512_%:
	@bdw_kill -job hls.dummy.BASIC_DMA512_$(*F)
	@bdw_kill -job hls.dummy.BASIC_DMA512_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC_DMA512)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


