################################################################
# List of all dep files outside sim_configs for make all_deps
################################################################
BDW_DEP_FILES = $(BDW_WORKLIB)/wrappers/dummy_wrap.d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/dummy.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA64/system.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA64/sc_main.d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy.d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA128/system.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA128/sc_main.d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy.d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/dummy.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA256/system.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA256/sc_main.d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/dummy.d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/dummy.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA512/system.d $(BDW_WORKLIB)/modules/tb/TESTBENCH_DMA512/sc_main.d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy.d


################################################################
# start of logicSynth Configurations
################################################################

# global logicSynth definitions


################################################################
# start of analysis Configurations
################################################################

# global analysis definitions


        
# analysisConfig specific definitions



ifeq ($(BDW_SIM_OBJS),)
ifeq ($(BDW_SPEC_NAME),)
BDW_USE_SIM_OBJS=$(SIM_OBJS)
else
BDW_USE_SIM_OBJS=`$(BDW_SPEC_FILTER) project.db $(BDW_SPEC_NAME) $(SIM_OBJS)`
endif
else
BDW_USE_SIM_OBJS=$(BDW_SIM_OBJS)
endif

ifeq ($(BDW_SHAREDLIB),0)
	EXECUTABLE			= scsim_$(BDW_SIM_CONFIG)
	
ifeq ($(BDW_DEBUG),1)
SIM_BUILD			= $(BDW_SIMDIR)/$(BDW_SIM_CONFIG)/xcelium/debug/sim_$(BDW_SIM_CONFIG)
else
SIM_BUILD			= $(BDW_SIMDIR)/$(BDW_SIM_CONFIG)/xcelium/sim_$(BDW_SIM_CONFIG)
endif
else
	EXECUTABLE			= $(BDW_VLOG_SIM)
	COSIM_FILES			= $(BDW_USE_SIM_OBJS) $(BDW_LIBPREP) $(BDW_EXTRA_OBJS) $(BDW_EXTRA_LIBS) $(BDW_ESC_LIB) $(VLOG_COSIM_TOP)
	SIM_BUILD			= $(COSIM_FILES)
endif


################################################################
# start of place and route configurations
################################################################

# pnrConfig specific definitions 

######################################################################
# Include dependency files for this configuration.
# These will be automatically generted if they do not exist.
# Avoid including (and so generating) these files for 'clean' and
# 'help' commands.
######################################################################
ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
    ifeq ($(findstring clean,$(MAKECMDGOALS)),)
        ifeq ($(findstring help,$(MAKECMDGOALS)),)
            ifneq ($(DEP_FILES),)
                -include $(DEP_FILES)
            endif
            ifneq ($(SIM_DEP_FILES),)
                ifeq ($(BDW_GENDEPS),1)
                    -include $(SIM_DEP_FILES)
                endif
            endif
        endif
    endif
endif

######################################################################
## Include pre-defined variables and rules provided with BDW
######################################################################

include ${STRATUS_HOME}/share/stratus/source/bdw.mak

######################################################################
## Error checking rules for variable and environment settings.
######################################################################
vista_needs_gcc3:
ifeq ($(BDW_GCC_VERSION),2.95.3)
	@echo "*** You must use GCC 3 to use Vista." ;  exit
endif

#########################################################
## Start of the "ALL" rule set
#########################################################

pnr_all:


kill_pnr_all:


clean_pnr_all:


power_all:


kill_power_all:


clean_power_all:


equiv_all:


kill_equiv_all:


clean_equiv_all:


ls_all:


kill_ls_all:


clean_ls_all:


analysis_all:


kill_analysis_all:


clean_analysis_all:


hls_sim_all: hls_BEHAV_DMA64 hls_BASIC_DMA64_V hls_BEHAV_DMA128 hls_BASIC_DMA128_V hls_BEHAV_DMA256 hls_BASIC_DMA256_V hls_BEHAV_DMA512 hls_BASIC_DMA512_V


cov_all:


kill_cov_all:


clean_cov_all:


hls_all: hls_dummy_BASIC_DMA64 hls_dummy_BASIC_DMA128 hls_dummy_BASIC_DMA256 hls_dummy_BASIC_DMA512


hls_dummy_all: hls_dummy_BASIC_DMA64 hls_dummy_BASIC_DMA128 hls_dummy_BASIC_DMA256 hls_dummy_BASIC_DMA512


cynth_all: cynth_BEHAV_DMA64 cynth_BASIC_DMA64_V cynth_BEHAV_DMA128 cynth_BASIC_DMA128_V cynth_BEHAV_DMA256 cynth_BASIC_DMA256_V cynth_BEHAV_DMA512 cynth_BASIC_DMA512_V


kill_hls_all kill_cynth_all: kill_hls_dummy_IOCFG_DMA64 kill_hls_dummy_BASIC_DMA64 kill_hls_dummy_IOCFG_DMA128 kill_hls_dummy_BASIC_DMA128 kill_hls_dummy_IOCFG_DMA256 kill_hls_dummy_BASIC_DMA256 kill_hls_dummy_IOCFG_DMA512 kill_hls_dummy_BASIC_DMA512


gen_all_deps: 
ifneq ($(BDW_DEP_FILES),)
	-@$(MAKE) $(BDW_DEP_FILES)
endif


.PHONY: gen_all_deps
.PHONY: all_deps


all_wrappers : bdw_prebuild_wrappers

bdw_prebuild_wrappers: 
ifneq ($(BDW_ALL_WRAPPERS),)
	@$(MAKE) -j 1 $(BDW_ALL_WRAPPERS)
endif

bdw_prebuild_rtl:
ifneq ($(SIM_RTL_TARGETS),)
ifneq ($(BDW_SPEC_NAME),)
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(BDW_SPEC_ARG) $(SIM_RTL_TARGETS)`
else
	@$(MAKE) $(SIM_RTL_TARGETS)
endif
endif

.PHONY: bdw_prebuild_sim_objs

bdw_prebuild_sim_objs:
ifneq ($(BDW_USE_SIM_OBJS),)
	@$(MAKE) $(BDW_USE_SIM_OBJS)
endif


clean_hls_all: clean_hls_BEHAV_DMA64 clean_hls_BASIC_DMA64_V clean_hls_BEHAV_DMA128 clean_hls_BASIC_DMA128_V clean_hls_BEHAV_DMA256 clean_hls_BASIC_DMA256_V clean_hls_BEHAV_DMA512 clean_hls_BASIC_DMA512_V

hls_clean_all: clean_hls_all
cynth_clean_all: clean_hls_all
clean_cynth_all: clean_hls_all
prebuild_all: prebuild_BEHAV_DMA64 prebuild_BASIC_DMA64_V prebuild_BEHAV_DMA128 prebuild_BASIC_DMA128_V prebuild_BEHAV_DMA256 prebuild_BASIC_DMA256_V prebuild_BEHAV_DMA512 prebuild_BASIC_DMA512_V

build_all: build_BEHAV_DMA64 build_BASIC_DMA64_V build_BEHAV_DMA128 build_BASIC_DMA128_V build_BEHAV_DMA256 build_BASIC_DMA256_V build_BEHAV_DMA512 build_BASIC_DMA512_V

sim_all: sim_BEHAV_DMA64 sim_BASIC_DMA64_V sim_BEHAV_DMA128 sim_BASIC_DMA128_V sim_BEHAV_DMA256 sim_BASIC_DMA256_V sim_BEHAV_DMA512 sim_BASIC_DMA512_V

kill_sim_all: kill_sim_BEHAV_DMA64 kill_sim_BASIC_DMA64_V kill_sim_BEHAV_DMA128 kill_sim_BASIC_DMA128_V kill_sim_BEHAV_DMA256 kill_sim_BASIC_DMA256_V kill_sim_BEHAV_DMA512 kill_sim_BASIC_DMA512_V

clean_wrap_all:
	@rm -fr $(BDW_WORKLIB)/wrappers

clean_spec_%:
	@$(BDW_SPEC_CLEAN) $(*F) -prefix

delete_spec_%:
	@$(BDW_SPEC_DELETE) $(*F) -prefix

kill_all: 
	@bdw_kill -all


clean_cachelib:
	@rm -rf /home/kevin/nov_submission/esp/accelerators/stratus_hls/dummy_stratus/hw/hls-work-inferred/cachelib

clean_all:
	@if [ -d $(BDW_WORKLIB) ] ; then \
		td=`mktemp -d $(BDW_WORKLIB).XXXXXXXX` ; \
		mv $(BDW_WORKLIB) $${td} ; \
		for f in *.vcd *.fsdb ; do \
			if [ -f $$f ] ; then \
				mv $$f $${td} ; \
			fi ; \
		done ; \
		rm -rf $${td} & \
	fi

clean_sim_all: clean_BEHAV_DMA64 clean_BASIC_DMA64_V clean_BEHAV_DMA128 clean_BASIC_DMA128_V clean_BEHAV_DMA256 clean_BASIC_DMA256_V clean_BEHAV_DMA512 clean_BASIC_DMA512_V clean_deps
	@rm -rf *.vcd *.fsdb $(BDW_OBJDIR) $(BDW_SIMDIR) $(BDW_MODULEDIR) $(BDW_WRAPDIR)

jobs:
	@bdw_ps

clean_libs:
	@rm -rf $(BDW_LIBDIR)

clean_deps:
	@if [ -d $(BDW_WORKLIB) ]; then find $(BDW_WORKLIB) -type f -name '*.d' -exec rm {} \; ; fi

deps : $(DEP_FILES)

