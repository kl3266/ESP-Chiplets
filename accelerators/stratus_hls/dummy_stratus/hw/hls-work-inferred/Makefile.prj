$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/dummy.d :  ../src/dummy.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config IOCFG_DMA512 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_dummy_IOCFG_DMA512)  ../src/dummy.cpp \
	| sed 's|dummy\.o[ :]*|$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/xcelium/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/xcelium/debug/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/dummy.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

