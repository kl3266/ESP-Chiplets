dummy_IOCFG_DMA256_SRCDIR = $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256
dummy_IOCFG_DMA256_BEH_SRCDIR = $(BDW_WORKLIB)/libs/dummy_IOCFG_DMA256
dummy_IOCFG_DMA256_LIBNAME = dummy_IOCFG_DMA256
dummy_IOCFG_DMA256_WORKLIB = $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/xcelium
dummy_IOCFG_DMA256_C_PARTS_A = $(dummy_IOCFG_DMA256_WORKLIB)/objs/libdummy_IOCFG_DMA256.a

prep_c_dummy_IOCFG_DMA256 : $(dummy_IOCFG_DMA256_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_IOCFG_DMA256_WORKLIB) prep_c

prep_vlog_dummy_IOCFG_DMA256 : $(dummy_IOCFG_DMA256_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_IOCFG_DMA256_WORKLIB) prep_vlog

prep_dummy_IOCFG_DMA256 : $(dummy_IOCFG_DMA256_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_IOCFG_DMA256_WORKLIB) prep

$(dummy_IOCFG_DMA256_WORKLIB)/Makefile : $(dummy_IOCFG_DMA256_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(dummy_IOCFG_DMA256_WORKLIB) ]; then mkdir -p $(dummy_IOCFG_DMA256_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_IOCFG_DMA256_SRCDIR) -o $(dummy_IOCFG_DMA256_WORKLIB)/Makefile -module dummy -cynthconfig IOCFG_DMA256   

$(dummy_IOCFG_DMA256_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(dummy_IOCFG_DMA256_WORKLIB) ]; then mkdir -p $(dummy_IOCFG_DMA256_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_dummy_IOCFG_DMA256_% : $(subst IOCFG_DMA256,IOCFG_DMA256_%,$(dummy_IOCFG_DMA256_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)) prep_c

prep_vlog_dummy_IOCFG_DMA256_% : $(subst IOCFG_DMA256,IOCFG_DMA256_%,$(dummy_IOCFG_DMA256_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)) prep_vlog

prep_dummy_IOCFG_DMA256_% : $(subst IOCFG_DMA256,IOCFG_DMA256_%,$(dummy_IOCFG_DMA256_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)) prep

$(subst IOCFG_DMA256,IOCFG_DMA256_%,$(dummy_IOCFG_DMA256_WORKLIB))/Makefile : $(dummy_IOCFG_DMA256_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)) ]; then mkdir -p $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_IOCFG_DMA256_SRCDIR)_$(*F) -o $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB))/Makefile -module dummy -cynthconfig IOCFG_DMA256_$(*F)   

$(dummy_IOCFG_DMA256_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)) ]; then mkdir -p $(subst IOCFG_DMA256,IOCFG_DMA256_$(*F),$(dummy_IOCFG_DMA256_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(dummy_IOCFG_DMA256_WORKLIB)/dummy_IOCFG_DMA256.d :
	@if [ ! -d $(dummy_IOCFG_DMA256_WORKLIB) ]; then mkdir -p $(dummy_IOCFG_DMA256_WORKLIB); fi
	@touch $(dummy_IOCFG_DMA256_WORKLIB)/dummy_IOCFG_DMA256.d



#
# HLS config BASIC_DMA256
#

#
#	stratus_hls rule
#
LIB_DIRS_dummy_BASIC_DMA256 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_BASIC_DMA256 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_BASIC_DMA256))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_BASIC_DMA256 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_dummy_BASIC_DMA256 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_dummy_BASIC_DMA256 = 
EXTRACT_LIB_DASHI_dummy_BASIC_DMA256 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy BASIC_DMA256]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_BASIC_DMA256 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/c_parts -DBASIC_DMA256=1 -DBDW_RTL_dummy_BASIC_DMA256=1 -DioConfig_IOCFG_DMA256 -D_p_ioConfig_IOCFG_DMA256 -DioConfig=IOCFG_DMA256 -D_wrap_ioConfig=IOCFG_DMA256 -DDMA_WIDTH=256 -D_wrap_DMA_WIDTH=256  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA256)
CCFLAGS_COSIM_dummy_BASIC_DMA256 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/c_parts -DBASIC_DMA256=1 -DBDW_RTL_dummy_BASIC_DMA256=1 -DioConfig_IOCFG_DMA256 -D_p_ioConfig_IOCFG_DMA256 -DioConfig=IOCFG_DMA256 -D_wrap_ioConfig=IOCFG_DMA256 -DDMA_WIDTH=256 -D_wrap_DMA_WIDTH=256  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA256)
CCFLAGS_BEH_dummy_BASIC_DMA256 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/c_parts -DBASIC_DMA256=1 -DioConfig_IOCFG_DMA256 -D_p_ioConfig_IOCFG_DMA256 -DioConfig=IOCFG_DMA256 -D_wrap_ioConfig=IOCFG_DMA256 -DDMA_WIDTH=256 -D_wrap_DMA_WIDTH=256  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA256)
CCFLAGS_dummy_BASIC_DMA256 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_BASIC_DMA256 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_BASIC_DMA256 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_dummy_BASIC_DMA256 hls_dummy_BASIC_DMA256

hls_dummy_BASIC_DMA256 : hlsc_dummy_BASIC_DMA256

cynth_dummy_BASIC_DMA256 : hlsc_dummy_BASIC_DMA256

elab_dummy_BASIC_DMA256 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/stratus_hls.bdr

optim_dummy_BASIC_DMA256 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/stratus_hls.bdr

sched_dummy_BASIC_DMA256 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/stratus_hls.bdr

hlsc_dummy_BASIC_DMA256 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/dummy_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC_DMA256 BDW_MODULE=dummy BDW_HLS_CONFIG=BASIC_DMA256 
else
	@bdw_exec -jobproject project.tcl -job hls.dummy.BASIC_DMA256 $(MAKE) CWBExec_hls=1 hlsc_dummy_BASIC_DMA256
