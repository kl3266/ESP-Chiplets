		-d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=IOCFG_DMA64 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA64))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_IOCFG_DMA64))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_IOCFG_DMA64))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_IOCFG_DMA64) \
		 ../src/dummy.cpp)))
	
	
	
	

else

