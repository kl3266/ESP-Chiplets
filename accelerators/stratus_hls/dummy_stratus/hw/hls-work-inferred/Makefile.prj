dummy_BASIC_DMA128_C_PARTS_A = $(dummy_BASIC_DMA128_WORKLIB)/objs/libdummy_BASIC_DMA128.a

prep_c_dummy_BASIC_DMA128 : $(dummy_BASIC_DMA128_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_BASIC_DMA128_WORKLIB) prep_c

prep_vlog_dummy_BASIC_DMA128 : $(dummy_BASIC_DMA128_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_BASIC_DMA128_WORKLIB) prep_vlog

prep_dummy_BASIC_DMA128 : $(dummy_BASIC_DMA128_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_BASIC_DMA128_WORKLIB) prep

$(dummy_BASIC_DMA128_WORKLIB)/Makefile : $(dummy_BASIC_DMA128_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(dummy_BASIC_DMA128_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA128_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_BASIC_DMA128_SRCDIR) -o $(dummy_BASIC_DMA128_WORKLIB)/Makefile -module dummy -cynthconfig BASIC_DMA128   

$(dummy_BASIC_DMA128_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(dummy_BASIC_DMA128_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA128_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_dummy_BASIC_DMA128_% : $(subst BASIC_DMA128,BASIC_DMA128_%,$(dummy_BASIC_DMA128_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)) prep_c

prep_vlog_dummy_BASIC_DMA128_% : $(subst BASIC_DMA128,BASIC_DMA128_%,$(dummy_BASIC_DMA128_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)) prep_vlog

prep_dummy_BASIC_DMA128_% : $(subst BASIC_DMA128,BASIC_DMA128_%,$(dummy_BASIC_DMA128_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)) prep

$(subst BASIC_DMA128,BASIC_DMA128_%,$(dummy_BASIC_DMA128_WORKLIB))/Makefile : $(dummy_BASIC_DMA128_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)) ]; then mkdir -p $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_BASIC_DMA128_SRCDIR)_$(*F) -o $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB))/Makefile -module dummy -cynthconfig BASIC_DMA128_$(*F)   

$(dummy_BASIC_DMA128_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)) ]; then mkdir -p $(subst BASIC_DMA128,BASIC_DMA128_$(*F),$(dummy_BASIC_DMA128_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(dummy_BASIC_DMA128_WORKLIB)/dummy_BASIC_DMA128.d :
	@if [ ! -d $(dummy_BASIC_DMA128_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA128_WORKLIB); fi
	@touch $(dummy_BASIC_DMA128_WORKLIB)/dummy_BASIC_DMA128.d



#
# HLS config IOCFG_DMA256
#

#
#	stratus_hls rule
#
LIB_DIRS_dummy_IOCFG_DMA256 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_IOCFG_DMA256 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA256))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_IOCFG_DMA256 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_dummy_IOCFG_DMA256 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_dummy_IOCFG_DMA256 = 
EXTRACT_LIB_DASHI_dummy_IOCFG_DMA256 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy IOCFG_DMA256]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_IOCFG_DMA256 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/c_parts  -DioConfig_IOCFG_DMA256 -D_p_ioConfig_IOCFG_DMA256 -DioConfig=IOCFG_DMA256 -D_wrap_ioConfig=IOCFG_DMA256 -DDMA_WIDTH=256 -D_wrap_DMA_WIDTH=256   $(LIB_INCLUDES_dummy_IOCFG_DMA256)
CCFLAGS_COSIM_dummy_IOCFG_DMA256 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/c_parts  -DioConfig_IOCFG_DMA256 -D_p_ioConfig_IOCFG_DMA256 -DioConfig=IOCFG_DMA256 -D_wrap_ioConfig=IOCFG_DMA256 -DDMA_WIDTH=256 -D_wrap_DMA_WIDTH=256   $(LIB_INCLUDES_dummy_IOCFG_DMA256)
CCFLAGS_BEH_dummy_IOCFG_DMA256 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/c_parts  -DioConfig_IOCFG_DMA256 -D_p_ioConfig_IOCFG_DMA256 -DioConfig=IOCFG_DMA256 -D_wrap_ioConfig=IOCFG_DMA256 -DDMA_WIDTH=256 -D_wrap_DMA_WIDTH=256   $(LIB_INCLUDES_dummy_IOCFG_DMA256)
CCFLAGS_dummy_IOCFG_DMA256 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_IOCFG_DMA256 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_IOCFG_DMA256 += ${BDW_CCFLAGS_TAIL}

