	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/ -I./ $(CCFLAGS_dummy_IOCFG_DMA512) $(EXTRACT_LIB_DASHI_dummy_IOCFG_DMA512) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/xcelium/debug/dummy_rtl.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512/xcelium/dummy_beh.o :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(BDW_WORKLIB)/wrappers/dummy_trace.h
