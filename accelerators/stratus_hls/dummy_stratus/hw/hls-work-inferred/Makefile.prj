		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512 \
		BDW_HLS_CONFIG=BASIC_DMA512 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_dummy_BASIC_DMA512) \
		-d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=BASIC_DMA512 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_BASIC_DMA512))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_BASIC_DMA512))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_BASIC_DMA512))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_BASIC_DMA512) \
		 ../src/dummy.cpp
	
	
	
	

else

$(BDW_dummy_BASIC_DMA512_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.dummy.BASIC_DMA512.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_dummy_BASIC_DMA512_HLS_TARGETS)

endif

	
