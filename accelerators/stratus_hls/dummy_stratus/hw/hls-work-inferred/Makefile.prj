#	RTL object file rule
#
$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_rtl.o) : $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy_rtl.cpp) $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl dummy`
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_dummy_BASIC_DMA64) $(EXTRACT_LIB_DASHI_dummy_BASIC_DMA64) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_rtl.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)

$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_rtl.o) : $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy_rtl.cpp) $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl dummy`
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_dummy_BASIC_DMA64) $(EXTRACT_LIB_DASHI_dummy_BASIC_DMA64) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_rtl.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_beh.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_BEH_dummy_BASIC_DMA64) -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_beh.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)

$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_beh.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_BEH_dummy_BASIC_DMA64) -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_beh.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)

#
# Cosim object file rule
#

$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_COSIM_dummy_BASIC_DMA64) -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)
    

$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_hoist.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_dummy_BASIC_DMA64) $(EXTRACT_LIB_DASHI_dummy_BASIC_DMA64) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_hoist.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)
    

$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_COSIM_dummy_BASIC_DMA64) -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)


$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_hoist.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA64/,/BASIC_DMA64$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/ -I./ $(CCFLAGS_dummy_BASIC_DMA64) $(EXTRACT_LIB_DASHI_dummy_BASIC_DMA64) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_hoist.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy.d :  ../src/dummy.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC_DMA64 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_dummy_BASIC_DMA64)  ../src/dummy.cpp \
	| sed 's|dummy\.o[ :]*|$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium/debug/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/dummy.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64"
##############################################################

dummy_BASIC_DMA64_SRCDIR = $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64
dummy_BASIC_DMA64_BEH_SRCDIR = $(BDW_WORKLIB)/libs/dummy_BASIC_DMA64
dummy_BASIC_DMA64_LIBNAME = dummy_BASIC_DMA64
dummy_BASIC_DMA64_WORKLIB = $(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/xcelium
dummy_BASIC_DMA64_C_PARTS_A = $(dummy_BASIC_DMA64_WORKLIB)/objs/libdummy_BASIC_DMA64.a

prep_c_dummy_BASIC_DMA64 : $(dummy_BASIC_DMA64_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_BASIC_DMA64_WORKLIB) prep_c

prep_vlog_dummy_BASIC_DMA64 : $(dummy_BASIC_DMA64_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_BASIC_DMA64_WORKLIB) prep_vlog

prep_dummy_BASIC_DMA64 : $(dummy_BASIC_DMA64_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(dummy_BASIC_DMA64_WORKLIB) prep

$(dummy_BASIC_DMA64_WORKLIB)/Makefile : $(dummy_BASIC_DMA64_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(dummy_BASIC_DMA64_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA64_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_BASIC_DMA64_SRCDIR) -o $(dummy_BASIC_DMA64_WORKLIB)/Makefile -module dummy -cynthconfig BASIC_DMA64   

$(dummy_BASIC_DMA64_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(dummy_BASIC_DMA64_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA64_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_dummy_BASIC_DMA64_% : $(subst BASIC_DMA64,BASIC_DMA64_%,$(dummy_BASIC_DMA64_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)) prep_c

prep_vlog_dummy_BASIC_DMA64_% : $(subst BASIC_DMA64,BASIC_DMA64_%,$(dummy_BASIC_DMA64_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)) prep_vlog

prep_dummy_BASIC_DMA64_% : $(subst BASIC_DMA64,BASIC_DMA64_%,$(dummy_BASIC_DMA64_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)) prep

$(subst BASIC_DMA64,BASIC_DMA64_%,$(dummy_BASIC_DMA64_WORKLIB))/Makefile : $(dummy_BASIC_DMA64_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)) ]; then mkdir -p $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_BASIC_DMA64_SRCDIR)_$(*F) -o $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB))/Makefile -module dummy -cynthconfig BASIC_DMA64_$(*F)   

$(dummy_BASIC_DMA64_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)) ]; then mkdir -p $(subst BASIC_DMA64,BASIC_DMA64_$(*F),$(dummy_BASIC_DMA64_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(dummy_BASIC_DMA64_WORKLIB)/dummy_BASIC_DMA64.d :
	@if [ ! -d $(dummy_BASIC_DMA64_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA64_WORKLIB); fi
	@touch $(dummy_BASIC_DMA64_WORKLIB)/dummy_BASIC_DMA64.d



#
# HLS config IOCFG_DMA128
#

#
#	stratus_hls rule
#
LIB_DIRS_dummy_IOCFG_DMA128 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_IOCFG_DMA128 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA128))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_IOCFG_DMA128 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_dummy_IOCFG_DMA128 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_dummy_IOCFG_DMA128 = 
EXTRACT_LIB_DASHI_dummy_IOCFG_DMA128 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy IOCFG_DMA128]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_IOCFG_DMA128 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/c_parts  -DioConfig_IOCFG_DMA128 -D_p_ioConfig_IOCFG_DMA128 -DioConfig=IOCFG_DMA128 -D_wrap_ioConfig=IOCFG_DMA128 -DDMA_WIDTH=128 -D_wrap_DMA_WIDTH=128   $(LIB_INCLUDES_dummy_IOCFG_DMA128)
CCFLAGS_COSIM_dummy_IOCFG_DMA128 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/c_parts  -DioConfig_IOCFG_DMA128 -D_p_ioConfig_IOCFG_DMA128 -DioConfig=IOCFG_DMA128 -D_wrap_ioConfig=IOCFG_DMA128 -DDMA_WIDTH=128 -D_wrap_DMA_WIDTH=128   $(LIB_INCLUDES_dummy_IOCFG_DMA128)
CCFLAGS_BEH_dummy_IOCFG_DMA128 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/c_parts  -DioConfig_IOCFG_DMA128 -D_p_ioConfig_IOCFG_DMA128 -DioConfig=IOCFG_DMA128 -D_wrap_ioConfig=IOCFG_DMA128 -DDMA_WIDTH=128 -D_wrap_DMA_WIDTH=128   $(LIB_INCLUDES_dummy_IOCFG_DMA128)
CCFLAGS_dummy_IOCFG_DMA128 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_IOCFG_DMA128 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_IOCFG_DMA128 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_dummy_IOCFG_DMA128 hls_dummy_IOCFG_DMA128

hls_dummy_IOCFG_DMA128 : hlsc_dummy_IOCFG_DMA128

cynth_dummy_IOCFG_DMA128 : hlsc_dummy_IOCFG_DMA128

elab_dummy_IOCFG_DMA128 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr

optim_dummy_IOCFG_DMA128 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr

sched_dummy_IOCFG_DMA128 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr

hlsc_dummy_IOCFG_DMA128 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.cpp BDW_DEP_CYNTH_CONFIG=IOCFG_DMA128 BDW_MODULE=dummy BDW_HLS_CONFIG=IOCFG_DMA128 
else
	@bdw_exec -jobproject project.tcl -job hls.dummy.IOCFG_DMA128 $(MAKE) CWBExec_hls=1 hlsc_dummy_IOCFG_DMA128
endif

clean_cynth_dummy_IOCFG_DMA128: clean_hls_dummy_IOCFG_DMA128

clean_dummy_IOCFG_DMA128: clean_hls_dummy_IOCFG_DMA128

clean_hls_dummy_IOCFG_DMA128:
	@rm -rf $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.IOCFG_DMA128
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.IOCFG_DMA128.s

kill_hls_dummy_IOCFG_DMA128:
	@bdw_kill -job hls.dummy.IOCFG_DMA128
	@bdw_kill -job hls.dummy.IOCFG_DMA128.s


hls_dummy_IOCFG_DMA128_% : hlsc_dummy_IOCFG_DMA128_%

cynth_dummy_IOCFG_DMA128_% : hlsc_dummy_IOCFG_DMA128_%

elab_dummy_IOCFG_DMA128_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /IOCFG_DMA128/,/IOCFG_DMA128_$(*F)/,$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr)

optim_dummy_IOCFG_DMA128_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /IOCFG_DMA128/,/IOCFG_DMA128_$(*F)/,$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr)

sched_dummy_IOCFG_DMA128_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /IOCFG_DMA128/,/IOCFG_DMA128_$(*F)/,$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr)

hlsc_dummy_IOCFG_DMA128_% hls_dummy_IOCFG_DMA128_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /IOCFG_DMA128/,/IOCFG_DMA128_$(*F)/,$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.cpp) BDW_DEP_CYNTH_CONFIG=IOCFG_DMA128 BDW_MODULE=dummy BDW_HLS_CONFIG=IOCFG_DMA128_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.dummy.IOCFG_DMA128_$(*F) $(MAKE) CWBExec_hls=1 hlsc_dummy_IOCFG_DMA128_$(*F)
endif

clean_cynth_dummy_IOCFG_DMA128_%: clean_hls_dummy_IOCFG_DMA128_%

clean_dummy_IOCFG_DMA128_%: clean_hls_dummy_IOCFG_DMA128_%

clean_hls_dummy_IOCFG_DMA128_%:
	@rm -rf $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.IOCFG_DMA128_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.dummy.IOCFG_DMA128_$(*F).s

kill_hls_dummy_IOCFG_DMA128_%:
	@bdw_kill -job hls.dummy.IOCFG_DMA128_$(*F)
	@bdw_kill -job hls.dummy.IOCFG_DMA128_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),IOCFG_DMA128)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_dummy_IOCFG_DMA128 :
	bdw_htmlgen -project project.tcl -module dummy -cynthconfig IOCFG_DMA128

BDW_dummy_IOCFG_DMA128_HLS_TARGETS = $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.v $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/stratus_hls.bdr
BDW_dummy_IOCFG_DMA128_HLS_SPEC_TARGETS = $(subst /IOCFG_DMA128/,/IOCFG_DMA128_%/,$(BDW_dummy_IOCFG_DMA128_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_dummy_IOCFG_DMA128_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128 ]; then mkdir -p $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=IOCFG_DMA128 BDW_CYNTH_CONFIG=IOCFG_DMA128 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.cpp \
		BDW_MODULE=dummy \
		BDW_CYNTH_CONFIG=IOCFG_DMA128 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128 \
		BDW_HLS_CONFIG=IOCFG_DMA128 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_dummy_IOCFG_DMA128) \
		-d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=IOCFG_DMA128 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA128))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_IOCFG_DMA128))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_IOCFG_DMA128))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_IOCFG_DMA128) \
		 ../src/dummy.cpp
	
	
	
	

else

$(BDW_dummy_IOCFG_DMA128_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.dummy.IOCFG_DMA128.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_dummy_IOCFG_DMA128_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_trace.h : $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_trace.h.updated

$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_trace.h.updated : $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module dummy -cynthconfig IOCFG_DMA128  
	@touch $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128/dummy_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_dummy_IOCFG_DMA128_HLS_SPEC_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA128_$(*F); fi
	
	
	$(subst /IOCFG_DMA128 ,/IOCFG_DMA128_$(*F) ,$(subst =IOCFG_DMA128 ,=IOCFG_DMA128_$(*F) ,$(subst /dummy/IOCFG_DMA128/,/dummy/IOCFG_DMA128_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=IOCFG_DMA128 BDW_CYNTH_CONFIG=IOCFG_DMA128 \
