#
# Per-hls_config rules
#

cynth_BASIC_DMA256:  cynth_dummy_BASIC_DMA256
hlsc_BASIC_DMA256:  
	$(MAKE) -j1 hlsc_dummy_BASIC_DMA256

cynthvlg_BASIC_DMA256: hls_BASIC_DMA256
hls_BASIC_DMA256:  
	$(MAKE) -j1 hls_dummy_BASIC_DMA256

cynthvlg_BASIC_DMA256: elab_BASIC_DMA256
elab_BASIC_DMA256:  
	$(MAKE) -j1 elab_dummy_BASIC_DMA256

cynthvlg_BASIC_DMA256: optim_BASIC_DMA256
optim_BASIC_DMA256:  
	$(MAKE) -j1 optim_dummy_BASIC_DMA256

cynthvlg_BASIC_DMA256: sched_BASIC_DMA256
sched_BASIC_DMA256:  
	$(MAKE) -j1 sched_dummy_BASIC_DMA256

view_BASIC_DMA256:
	@echo "ERROR: Schematic viewing target 'view_BASIC_DMA256' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


clean_BASIC_DMA256:
	@rm -f $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/BASIC_DMA256/stratus_hls.bdr


