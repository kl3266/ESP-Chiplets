ifeq ($(CWBExec_hlsc),1)

$(BDW_dummy_IOCFG_DMA512_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512 ]; then mkdir -p $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=IOCFG_DMA512 BDW_CYNTH_CONFIG=IOCFG_DMA512 \
