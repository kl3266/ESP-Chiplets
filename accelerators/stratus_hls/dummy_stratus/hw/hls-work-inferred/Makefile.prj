	$(subst /IOCFG_DMA64 ,/IOCFG_DMA64_$(*F) ,$(subst =IOCFG_DMA64 ,=IOCFG_DMA64_$(*F) ,$(subst /dummy/IOCFG_DMA64/,/dummy/IOCFG_DMA64_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=IOCFG_DMA64 BDW_CYNTH_CONFIG=IOCFG_DMA64 \
