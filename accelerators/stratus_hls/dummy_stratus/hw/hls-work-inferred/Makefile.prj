BDW_dummy_IOCFG_DMA64_HLS_TARGETS = $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/dummy_rtl.v $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/stratus_hls.bdr
