ifeq ($(CWBExec_hlsc),1)

$(BDW_dummy_BASIC_DMA512_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512 ]; then mkdir -p $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_DMA512 BDW_CYNTH_CONFIG=BASIC_DMA512 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA512/dummy_rtl.cpp \
		BDW_MODULE=dummy \
