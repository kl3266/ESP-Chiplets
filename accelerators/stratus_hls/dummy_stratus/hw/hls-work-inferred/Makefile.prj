LIB_DIRS_dummy_IOCFG_DMA512 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_IOCFG_DMA512 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA512))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_IOCFG_DMA512 = $(memlib_LIBNAME) 
