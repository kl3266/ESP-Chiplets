	@if [ ! -d $(dummy_BASIC_DMA512_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA512_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_dummy_BASIC_DMA512_% : $(subst BASIC_DMA512,BASIC_DMA512_%,$(dummy_BASIC_DMA512_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)) prep_c

prep_vlog_dummy_BASIC_DMA512_% : $(subst BASIC_DMA512,BASIC_DMA512_%,$(dummy_BASIC_DMA512_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)) prep_vlog

prep_dummy_BASIC_DMA512_% : $(subst BASIC_DMA512,BASIC_DMA512_%,$(dummy_BASIC_DMA512_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)) prep

$(subst BASIC_DMA512,BASIC_DMA512_%,$(dummy_BASIC_DMA512_WORKLIB))/Makefile : $(dummy_BASIC_DMA512_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)) ]; then mkdir -p $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_BASIC_DMA512_SRCDIR)_$(*F) -o $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB))/Makefile -module dummy -cynthconfig BASIC_DMA512_$(*F)   

$(dummy_BASIC_DMA512_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)) ]; then mkdir -p $(subst BASIC_DMA512,BASIC_DMA512_$(*F),$(dummy_BASIC_DMA512_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(dummy_BASIC_DMA512_WORKLIB)/dummy_BASIC_DMA512.d :
	@if [ ! -d $(dummy_BASIC_DMA512_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA512_WORKLIB); fi
	@touch $(dummy_BASIC_DMA512_WORKLIB)/dummy_BASIC_DMA512.d



