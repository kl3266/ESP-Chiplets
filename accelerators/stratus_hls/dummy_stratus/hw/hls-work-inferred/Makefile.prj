	$(subst /BASIC_DMA128 ,/BASIC_DMA128_$(*F) ,$(subst =BASIC_DMA128 ,=BASIC_DMA128_$(*F) ,$(subst /dummy/BASIC_DMA128/,/dummy/BASIC_DMA128_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_DMA128 BDW_CYNTH_CONFIG=BASIC_DMA128 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy_rtl.v \
