	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig BASIC_DMA512_V_$(*F) -top top


#############################################################################
# libesc building rules
#############################################################################

ifeq ($(BDW_DEBUG),1)
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/xcelium/debug
else
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/xcelium
endif

BDW_ESC_SOURCES = libesc.o esc_elab.o esc_cleanup.o
BDW_ESC_OBJS = $(addprefix $(libesc_WORKDIR)/, $(BDW_ESC_SOURCES))

$(libesc_WORKDIR)/libesc.a : $(BDW_ESC_OBJS)
	$(BDW_AR) $(libesc_WORKDIR)/libesc.a $(BDW_ESC_OBJS)

${libesc_WORKDIR}/%.o   :   ${STRATUS_HOME}/share/stratus/source/%.cc 
	@if [ ! -d ${libesc_WORKDIR} ]; then mkdir -p ${libesc_WORKDIR}; fi
ifeq ($(BDW_NCSC),1)
	${BDW_CC} " ${BDW_CCFLAGS} ${BDW_COUT}$@ " $<
else
	${BDW_CC} ${BDW_CCFLAGS} ${BDW_COUT}$@ $<
endif




##############################################################
## Parts Library "./memlib"
##############################################################

memlib_SRCDIR = ./memlib
memlib_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memlib
memlib_LIBNAME = memlib
memlib_WORKLIB = $(BDW_WORKLIB)/libs/memlib/xcelium
memlib_C_PARTS_A = $(memlib_WORKLIB)/objs/libmemlib.a

prep_c_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep_c

prep_vlog_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep_vlog

prep_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep

$(memlib_WORKLIB)/Makefile : $(memlib_SRCDIR)/
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen  -scsim xcelium -lib $(memlib_SRCDIR) -o $(memlib_WORKLIB)/Makefile -module  -cynthconfig    -project project.tcl

$(memlib_SRCDIR)/ :
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi




BDW_LIBEXT_memlib=$(shell if test -f $(memlib_SRCDIR)/c_parts/memlib.cc ; then echo "cc"; else echo "cpp"; fi)

$(memlib_WORKLIB)/memlib.d : $(memlib_SRCDIR)/c_parts/memlib.$(BDW_LIBEXT_memlib)
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) $< | sed 's|memlib\.o[ :]*|memlib_DEPS = |' $(BDW_DEP_FILTER) > $@



BDW_C_LIBPREP += prep_c_memlib
BDW_C_LIBREF += $(memlib_WORKLIB)/INCA_libs/memlib_worklib
BDW_VLOG_LIBPREP += prep_vlog_memlib
BDW_BOTH_LIBPREP += prep_memlib


BDW_HLSLIB_DIRS += $(BDW_WORKLIB)/libs/memlib/xcelium
BDW_HLSLIB_NAMES += $(memlib_LIBNAME)


BDW_WHOLELIB_DIRS += $(memlib_SRCDIR)
BDW_WHOLELIB_NAMES += $(memlib_LIBNAME)


########################################################################
# Rules to prep all libraries
#######################################################################
prep_c_all: $(BDW_C_LIBPREP)

prep_vlog_all: $(BDW_VLOG_LIBPREP)


##############################################################
## Rule for building all Cynth libraries external to the project
##############################################################

build_all_cynthLibs: $(BDW_BOTH_LIBPREP_EXTERNAL)

list_cynthLibs:

	@echo /home/kevin/nov_submission/esp/accelerators/stratus_hls/dummy_stratus/hw/hls-work-inferred ./memlib prep_memlib

##############################################################
## START OF HLS MODULE RULES
##############################################################



##############################################################
## HLS Module "dummy"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/dummy.d :  ../src/dummy.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  ../src/dummy.cpp \
	| sed 's|dummy\.o[ :]*|$(BDW_OBJDIR)/dummy.o $(BDW_OBJDIR)/dummy.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/dummy_trace.h : $(BDW_WORKLIB)/wrappers/dummy_trace.h.updated

$(BDW_WORKLIB)/wrappers/dummy_trace.h.updated :  ../src/dummy.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module dummy  
	@touch $(BDW_WORKLIB)/wrappers/dummy_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/dummy.o:  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(BDW_WORKLIB)/wrappers/dummy_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/dummy.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/dummy.o:  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(BDW_WORKLIB)/wrappers/dummy_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/dummy.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp

.INTERMEDIATE : dummy_wrap.h

dummy_wrap.h : $(BDW_WORKLIB)/wrappers/dummy_wrap.h

$(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(BDW_WORKLIB)/wrappers/dummy_cosim.v   : $(BDW_WRAPDIR)/dummy.updated

$(BDW_WRAPDIR)/dummy.updated :  ../src/dummy.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module dummy "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/dummy.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module dummy  
	@touch $(BDW_WORKLIB)/wrappers/dummy_trace.h.updated
$(BDW_WORKLIB)/wrappers/dummy_wrap.d :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  ../src/dummy.cpp \
		| sed 's|dummy\.o[ :]*|$(BDW_WRAPDIR)/dummy.updated $(BDW_WORKLIB)/wrappers/dummy_wrap.d :  memlib/memlib.bdl |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/dummy_wrap.d 




##############################################################
## HLS Module "dummy" - cynthConfigs
##############################################################


#
# HLS config IOCFG_DMA64
#

#
#	stratus_hls rule
#
LIB_DIRS_dummy_IOCFG_DMA64 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_IOCFG_DMA64 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA64))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_IOCFG_DMA64 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_dummy_IOCFG_DMA64 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_dummy_IOCFG_DMA64 = 
EXTRACT_LIB_DASHI_dummy_IOCFG_DMA64 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy IOCFG_DMA64]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_IOCFG_DMA64 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/c_parts  -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64   $(LIB_INCLUDES_dummy_IOCFG_DMA64)
CCFLAGS_COSIM_dummy_IOCFG_DMA64 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/c_parts  -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64   $(LIB_INCLUDES_dummy_IOCFG_DMA64)
CCFLAGS_BEH_dummy_IOCFG_DMA64 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA64/c_parts  -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64   $(LIB_INCLUDES_dummy_IOCFG_DMA64)
CCFLAGS_dummy_IOCFG_DMA64 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_IOCFG_DMA64 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_IOCFG_DMA64 += ${BDW_CCFLAGS_TAIL}

