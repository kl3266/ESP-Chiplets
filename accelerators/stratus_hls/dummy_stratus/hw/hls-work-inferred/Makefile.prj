$(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/xcelium/debug/dummy.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.h $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/ -I./ $(CCFLAGS_COSIM_dummy_BASIC_DMA128) -o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/xcelium/debug/dummy.o " $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp)


$(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/xcelium/debug/dummy_hoist.o) :  ../src/dummy.cpp $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp $(BDW_WORKLIB)/wrappers/dummy_cosim.h $(subst /BASIC_DMA128/,/BASIC_DMA128$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/dummy_trace.h)
