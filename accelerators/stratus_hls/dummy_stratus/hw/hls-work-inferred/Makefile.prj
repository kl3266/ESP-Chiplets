		-d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA512 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=BASIC_DMA512 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_BASIC_DMA512))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_BASIC_DMA512))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_BASIC_DMA512))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_BASIC_DMA512) \
		 ../src/dummy.cpp)))
	
	
	
	

else

