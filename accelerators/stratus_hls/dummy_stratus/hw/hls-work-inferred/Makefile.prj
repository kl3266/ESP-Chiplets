	@if [ ! -d $(dummy_BASIC_DMA512_WORKLIB) ]; then mkdir -p $(dummy_BASIC_DMA512_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(dummy_BASIC_DMA512_SRCDIR) -o $(dummy_BASIC_DMA512_WORKLIB)/Makefile -module dummy -cynthconfig BASIC_DMA512   

