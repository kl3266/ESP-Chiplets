		BDW_MODULE=dummy \
		BDW_CYNTH_CONFIG=IOCFG_DMA512 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512 \
		BDW_HLS_CONFIG=IOCFG_DMA512 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_dummy_IOCFG_DMA512) \
		-d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA512 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=IOCFG_DMA512 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA512))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_IOCFG_DMA512))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_IOCFG_DMA512))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_IOCFG_DMA512) \
		 ../src/dummy.cpp
	
	
	
	

else

