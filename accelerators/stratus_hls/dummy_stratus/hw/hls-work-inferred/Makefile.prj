	bdw_exec -jobproject project.tcl -job hls.dummy.BASIC_DMA512_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_dummy_BASIC_DMA512_HLS_SPEC_TARGETS))

