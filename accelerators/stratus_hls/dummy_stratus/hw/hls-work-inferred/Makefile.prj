BDW_dummy_BASIC_DMA128_HLS_SPEC_TARGETS = $(subst /BASIC_DMA128/,/BASIC_DMA128_%/,$(BDW_dummy_BASIC_DMA128_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_dummy_BASIC_DMA128_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128 ]; then mkdir -p $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_DMA128 BDW_CYNTH_CONFIG=BASIC_DMA128 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy_rtl.cpp \
		BDW_MODULE=dummy \
		BDW_CYNTH_CONFIG=BASIC_DMA128 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128 \
		BDW_HLS_CONFIG=BASIC_DMA128 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_dummy_BASIC_DMA128) \
		-d $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=BASIC_DMA128 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_BASIC_DMA128))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_BASIC_DMA128))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_BASIC_DMA128))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_BASIC_DMA128) \
		 ../src/dummy.cpp
	
	
	
	

else

$(BDW_dummy_BASIC_DMA128_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.dummy.BASIC_DMA128.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_dummy_BASIC_DMA128_HLS_TARGETS)

endif

	
