$(BDW_WORKLIB)/modules/tb/IOCFG_DMA64/system.d: ../tb/system.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for system config IOCFG_DMA64 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_tb_IOCFG_DMA64) $< \
