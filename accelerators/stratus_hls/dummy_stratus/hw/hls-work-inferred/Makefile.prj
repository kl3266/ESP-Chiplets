endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy.d :  ../src/dummy.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC_DMA128 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_dummy_BASIC_DMA128)  ../src/dummy.cpp \
	| sed 's|dummy\.o[ :]*|$(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy_rtl.cpp $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/xcelium/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/xcelium/debug/dummy_beh.o $(BDW_WORKLIB)/modules/dummy/BASIC_DMA128/dummy.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
