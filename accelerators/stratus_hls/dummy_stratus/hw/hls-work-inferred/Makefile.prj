	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=BEHAV_DMA64  BDW_BASE_SIM_CONFIG=BEHAV_DMA64 BDW_SPEC_NAME=



clean_wrap_BEHAV_DMA64:
	@rm -f $(BDW_WORKLIB)/wrappers/dummy_wrap.cpp
	@rm -f $(BDW_WORKLIB)/wrappers/dummy_wrap.h
	@rm -f $(BDW_WORKLIB)/wrappers/dummy_wrap.d
	@rm -f $(BDW_WORKLIB)/wrappers/dummy_sc_wrap.cpp
