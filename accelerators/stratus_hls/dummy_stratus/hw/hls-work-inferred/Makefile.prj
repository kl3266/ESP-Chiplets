ifneq (,)
	@$(MAKE)  $(addprefix clean_, )
endif

clean_cynth_BEHAV_DMA64: clean_hls_BEHAV_DMA64

prebuild_BEHAV_DMA64: bdw_prebuild_wrappers 

prep_BEHAV_DMA64: prebuild_BEHAV_DMA64
	@$(MAKE) sim_BEHAV_DMA64 BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_BEHAV_DMA64:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEHAV_DMA64
	@$(MAKE) BDW_DEBUG=1 build_BEHAV_DMA64


build_BEHAV_DMA64 build_BEHAV_DMA64_sub: bdw_prebuild_wrappers 
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEHAV_DMA64
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=BEHAV_DMA64 BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=BEHAV_DMA64 BDW_SPEC_NAME=

build_only_BEHAV_DMA64:
	@$(MAKE) siminfo BDW_SIM_CONFIG=BEHAV_DMA64
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=BEHAV_DMA64 BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=BEHAV_DMA64 BDW_SPEC_NAME=

else
.PHONY: build_BEHAV_DMA64
.PHONY: dbg_build_BEHAV_DMA64

dbg_build_BEHAV_DMA64:
	@bdw_exec -jobproject project.tcl -job dbg_build.BEHAV_DMA64 $(MAKE) CWBExec_build=1 dbg_build_BEHAV_DMA64

build_BEHAV_DMA64:
	@bdw_exec -jobproject project.tcl -job build.BEHAV_DMA64 $(MAKE) CWBExec_build=1 build_BEHAV_DMA64

build_BEHAV_DMA64_sub:
	@bdw_exec -jobproject project.tcl -job build.BEHAV_DMA64.s $(MAKE) CWBExec_build=1 build_BEHAV_DMA64_sub
endif


ifeq ($(CWBExec_sim),1)
sim_BEHAV_DMA64 sim_sub_BEHAV_DMA64: build_BEHAV_DMA64_sub
	@$(MAKE) run_sim BDW_SIM_CONFIG=BEHAV_DMA64  BDW_BASE_SIM_CONFIG=BEHAV_DMA64 BDW_SPEC_NAME= 

sim_only_BEHAV_DMA64:
	@$(MAKE) run_sim BDW_SIM_CONFIG=BEHAV_DMA64  BDW_BASE_SIM_CONFIG=BEHAV_DMA64 BDW_SPEC_NAME= 

else
.PHONY: sim_BEHAV_DMA64

sim_BEHAV_DMA64:
	@bdw_exec -jobproject project.tcl -job sim.BEHAV_DMA64 $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_BEHAV_DMA64

sim_sub_BEHAV_DMA64:
	@bdw_exec -jobproject project.tcl -job sim_sub.BEHAV_DMA64.s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_BEHAV_DMA64
endif


kill_sim_BEHAV_DMA64:
	@bdw_kill -job sim.BEHAV_DMA64
	@bdw_kill -job sim.BEHAV_DMA64.s


catlog_BEHAV_DMA64: 
debug_BEHAV_DMA64: 
	@$(MAKE) BDW_DEBUG=1 build_BEHAV_DMA64
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=BEHAV_DMA64  BDW_BASE_SIM_CONFIG=BEHAV_DMA64 BDW_SPEC_NAME= RUN_DEBUGGER=1
    

view_BEHAV_DMA64:
	@echo "Error: enable_waveform_logging is not enabled"
            



clean_BEHAV_DMA64: clean_hls_BEHAV_DMA64 clean_sim_BEHAV_DMA64

clean_sim_BEHAV_DMA64:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BEHAV_DMA64.s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BEHAV_DMA64
	@rm -rf $(BDW_WORKLIB)/jobs/build.BEHAV_DMA64
