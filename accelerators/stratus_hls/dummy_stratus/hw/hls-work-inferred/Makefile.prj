BDW_dummy_IOCFG_DMA256_HLS_SPEC_TARGETS = $(subst /IOCFG_DMA256/,/IOCFG_DMA256_%/,$(BDW_dummy_IOCFG_DMA256_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_dummy_IOCFG_DMA256_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256 ]; then mkdir -p $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=IOCFG_DMA256 BDW_CYNTH_CONFIG=IOCFG_DMA256 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/dummy_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/dummy_rtl.cpp \
		BDW_MODULE=dummy \
		BDW_CYNTH_CONFIG=IOCFG_DMA256 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256 \
		BDW_HLS_CONFIG=IOCFG_DMA256 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_dummy_IOCFG_DMA256) \
		-d $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256 -o dummy_rtl.cpp \
		--hls_module=dummy --hls_config=IOCFG_DMA256 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_dummy_IOCFG_DMA256))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_dummy_IOCFG_DMA256))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_dummy_IOCFG_DMA256))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_dummy_IOCFG_DMA256) \
		 ../src/dummy.cpp
	
	
	
	

else

$(BDW_dummy_IOCFG_DMA256_HLS_TARGETS) :  ../src/dummy.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.dummy.IOCFG_DMA256.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_dummy_IOCFG_DMA256_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/dummy_trace.h : $(BDW_WORKLIB)/modules/dummy/IOCFG_DMA256/dummy_trace.h.updated

