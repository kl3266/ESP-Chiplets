	@touch $(dummy_IOCFG_DMA64_WORKLIB)/dummy_IOCFG_DMA64.d



#
# HLS config BASIC_DMA64
#

#
#	stratus_hls rule
#
LIB_DIRS_dummy_BASIC_DMA64 = $(memlib_SRCDIR) 
LIB_INCLUDES_dummy_BASIC_DMA64 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_dummy_BASIC_DMA64))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_dummy_BASIC_DMA64 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_dummy_BASIC_DMA64 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_dummy_BASIC_DMA64 = 
EXTRACT_LIB_DASHI_dummy_BASIC_DMA64 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl dummy BASIC_DMA64]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_dummy_BASIC_DMA64 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/c_parts -DBASIC_DMA64=1 -DBDW_RTL_dummy_BASIC_DMA64=1 -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA64)
CCFLAGS_COSIM_dummy_BASIC_DMA64 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/c_parts -DBASIC_DMA64=1 -DBDW_RTL_dummy_BASIC_DMA64=1 -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA64)
CCFLAGS_BEH_dummy_BASIC_DMA64 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/dummy/BASIC_DMA64/c_parts -DBASIC_DMA64=1 -DioConfig_IOCFG_DMA64 -D_p_ioConfig_IOCFG_DMA64 -DioConfig=IOCFG_DMA64 -D_wrap_ioConfig=IOCFG_DMA64 -DDMA_WIDTH=64 -D_wrap_DMA_WIDTH=64  -DHLS_DIRECTIVES_BASIC $(LIB_INCLUDES_dummy_BASIC_DMA64)
CCFLAGS_dummy_BASIC_DMA64 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_dummy_BASIC_DMA64 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_dummy_BASIC_DMA64 += ${BDW_CCFLAGS_TAIL}

